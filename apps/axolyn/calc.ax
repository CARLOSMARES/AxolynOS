import core;

fn main() {
    core.println("Tabla de multiplicar del 7:");
    var i: int = 1;
    while (i <= 10) {
        core.print_int(7);
        core.print(" x ");
        core.print_int(i);
        core.print(" = ");
        core.print_int(7 * i);
        core.println("");
        i = i + 1;
    }
}
