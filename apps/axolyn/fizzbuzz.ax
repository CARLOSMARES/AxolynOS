import core;

fn main() {
    var i: int = 1;
    while (i <= 20) {
        if (i % 15 == 0) {
            core.println("FizzBuzz");
        } else if (i % 3 == 0) {
            core.println("Fizz");
        } else if (i % 5 == 0) {
            core.println("Buzz");
        } else {
            core.print_int(i);
            core.println("");
        }
        i = i + 1;
    }
}
