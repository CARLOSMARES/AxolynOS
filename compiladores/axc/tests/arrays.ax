/*
 * Prueba: arrays de tamano fijo, indexacion y recorrido.
 */
import core;

fn suma(a: [5]int): int {
    var i: int = 0;
    var total: int = 0;
    while (i < 5) {
        total = total + a[i];
        i = i + 1;
    }
    return total;
}

fn maximo(a: [5]int): int {
    var i: int = 1;
    var m: int = a[0];
    while (i < 5) {
        if (a[i] > m) {
            m = a[i];
        }
        i = i + 1;
    }
    return m;
}

fn main() {
    var a: [5]int;
    var i: int = 0;
    while (i < 5) {
        a[i] = i * i;
        i = i + 1;
    }

    i = 0;
    while (i < 5) {
        core.print_int(a[i]);
        core.print(" ");
        i = i + 1;
    }
    core.println("");

    core.print("suma = ");
    core.print_int(suma(a));
    core.println("");

    core.print("maximo = ");
    core.print_int(maximo(a));
    core.println("");

    a[2] = 100;
    core.print("a[2] = ");
    core.print_int(a[2]);
    core.println("");
}
