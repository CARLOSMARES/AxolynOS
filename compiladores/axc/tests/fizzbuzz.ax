/*
 * Prueba: FizzBuzz con 'for', 'if / else if' y operadores aritmeticos.
 */
import core;

fn main() {
    for (var i: int = 1; i <= 20; i = i + 1) {
        if (i % 15 == 0) {
            core.println("FizzBuzz");
        } else if (i % 3 == 0) {
            core.println("Fizz");
        } else if (i % 5 == 0) {
            core.println("Buzz");
        } else {
            core.print_int(i);
            core.println("");
        }
    }
}
